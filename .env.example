# Appwrite project configuration (public — safe to expose to the browser).
PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
PUBLIC_APPWRITE_PROJECT=developer-wrapped

# Server-only. API key with the `sessions.write` scope — needed to exchange the
# OAuth token for a session (Appwrite only returns session secrets to API keys).
APPWRITE_API_KEY=
